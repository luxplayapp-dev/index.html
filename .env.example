# AdgeCalculator Production Environment Variables Example

# Application Domain Base URL
NEXT_PUBLIC_APP_URL=https://adgecalculator.com

# Privacy-Friendly Analytics Tracking ID (Google Analytics / Plausible - Optional)
# NEXT_PUBLIC_ANALYTICS_ID=G-XXXXXXXXXX

# Monetization & Sponsor Ad Slots Toggle (true/false - Optional, default: true)
NEXT_PUBLIC_ENABLE_ADS=true
